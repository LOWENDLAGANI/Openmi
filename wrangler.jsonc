{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openmi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workflows": [
    {
      "name": "openmi-task",
      "binding": "TASK_WORKFLOW",
      "class_name": "TaskWorkflow"
    }
  ],
  // NOTE: firebase-admin requires a Node runtime and cannot run on the
  // Cloudflare Workers edge. The Vercel/Node runtime (api/index.ts) is the
  // supported deployment target after the Firebase pivot. wrangler config is
  // retained for reference and is marked external so it still bundles.
  "external": ["firebase-admin", "google-auth-library", "@vercel/oidc"],
  "vars": {
    "FIREBASE_PROJECT_ID": "",
    "FIREBASE_API_KEY": "",
    "OPENMI_MODEL": "qwen/qwen3-coder",
    "DAILY_TASK_LIMIT": "5",
    "MAX_CONCURRENT_TASKS": "2",
    "DEFAULT_COMMIT_MODE": "direct",
    "GITHUB_APP_ID": "",
    "GITHUB_APP_CLIENT_ID": "",
    "GITHUB_APP_SLUG": ""
  },
  "dev": {
    "port": 8787
  }
}
