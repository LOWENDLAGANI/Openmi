# Local development secrets for `wrangler dev` and `npm run dev:api`.
# Copy to .dev.vars (gitignored) and fill in. Never commit real values.
# For `vercel dev` use the same keys in .env.local instead.

# Firebase project. Project id + web API key are public; also set them in
# wrangler.jsonc "vars" so /api/config can hand the web config to the browser.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_API_KEY="web-api-key"
# Optional: defaults to <project-id>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# FIREBASE_APP_ID="1:xxx:web:yyy"
# Service account (server-only). Project settings -> Service accounts.
# Never expose to the browser. Literal \n escapes in the PEM are accepted.
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# base64-encoded 32-byte AES-GCM key used to encrypt stored GitHub tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENC_KEY=""
# AI provider. OpenRouter is primary; Groq is an optional fallback.
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# --- GitHub App (Phase 2, optional but recommended) -------------------------
# Create the App in GitHub settings, then set the public ids in wrangler.jsonc
# (GITHUB_APP_ID / GITHUB_APP_CLIENT_ID / GITHUB_APP_SLUG) and the secrets here.
# The setup URL is https://<your-origin>/api/github-app/callback and the webhook
# URL is https://<your-origin>/api/webhooks/github.
#
# Private key: PKCS#8 PEM. Literal \n escapes are accepted.
# Generate one from the PKCS#1 file GitHub gives you:
#   openssl pkcs8 -topk8 -nocrypt -in app.pem -out app-pkcs8.pem
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
# Optional: separate secret for signing install state (defaults to webhook secret).
GITHUB_APP_STATE_SECRET=""

# --- Background runner (required for the Node/Vercel runtime) ----------------
# `npm run dev:api` and Vercel dispatch tasks by POSTing to the runner endpoint.
# Cloudflare ignores these: the TASK_WORKFLOW binding is used instead.
APP_ORIGIN="http://localhost:8787"
# Random 32+ chars shared with the internal runner endpoint.
INTERNAL_TASK_TOKEN=""
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/recover.
CRON_SECRET=""
# Seconds one invocation may spend on a task before handing off (default 240).
RUN_BUDGET_SECONDS="240"
