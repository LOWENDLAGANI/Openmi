# Local development secrets for `wrangler dev`.
# Copy to .dev.vars (gitignored) and fill in. Never commit real values.

# Supabase project (Settings -> API). URL + anon key are public; also set them
# in wrangler.jsonc "vars" so the built SPA can read SUPABASE_URL at runtime.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Server-only: bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# DEV ONLY: legacy HS256 verification fallback for local JWT tests.
# Leave empty to use asymmetric JWKS verification (the production path).
SUPABASE_JWT_SECRET=""

# base64-encoded 32-byte AES-GCM key used to encrypt stored GitHub tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENC_KEY=""

# AI provider. OpenRouter is primary; Groq is an optional fallback.
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# --- GitHub App (Phase 2, optional but recommended) -------------------------
# Create the App in GitHub settings, then set the public ids in wrangler.jsonc
# (GITHUB_APP_ID / GITHUB_APP_CLIENT_ID / GITHUB_APP_SLUG) and the secrets here.
# The setup URL is https://<your-origin>/api/github-app/callback and the webhook
# URL is https://<your-origin>/api/webhooks/github.
#
# Private key: PKCS#8 PEM. Literal \n escapes are accepted.
# Generate one from the PKCS#1 file GitHub gives you:
#   openssl pkcs8 -topk8 -nocrypt -in app.pem -out app-pkcs8.pem
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
# Optional: separate secret for signing install state (defaults to webhook secret).
GITHUB_APP_STATE_SECRET=""
