# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Token encryption (AES-256-GCM, base64, 32 bytes)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENC_KEY=

# Model providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENMI_MODEL=qwen/qwen3-coder

# Quota
DAILY_TASK_LIMIT=5
MAX_CONCURRENT_TASKS=2
DEFAULT_COMMIT_MODE=direct

# Runtime / dispatch
APP_ORIGIN=http://localhost:8787
INTERNAL_TASK_TOKEN=
INTERNAL_DISPATCH_URL=
CRON_SECRET=
RUN_BUDGET_SECONDS=240

# GitHub App (optional; enables installation-token auth)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=
