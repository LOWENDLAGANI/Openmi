# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Token encryption (AES-256-GCM, base64, 32 bytes)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENC_KEY=

# Model providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Primary model + fallbacks tried in order when the primary is unavailable
OPENMI_MODEL=qwen/qwen3-coder-next
OPENMI_MODEL_FALLBACKS=qwen/qwen3-coder,qwen/qwen3-coder-flash
# Groq fallback model (llama-3.3-70b-versatile was retired for free/Developer tiers)
GROQ_MODEL=openai/gpt-oss-120b

# Quota
DAILY_TASK_LIMIT=5
MAX_CONCURRENT_TASKS=2
DEFAULT_COMMIT_MODE=direct

# Runtime / dispatch
APP_ORIGIN=http://localhost:8787
INTERNAL_TASK_TOKEN=
INTERNAL_DISPATCH_URL=
CRON_SECRET=
# Runner wall-clock budget (seconds). Clamped to MAX_FUNCTION_DURATION - 10.
RUN_BUDGET_SECONDS=50
# Hard ceiling of the serverless function (must match maxDuration in api/[[...route]].ts)
MAX_FUNCTION_DURATION=60

# GitHub App (optional; enables installation-token auth)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=
