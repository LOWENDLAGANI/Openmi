# ── Openmi environment ────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in what this deployment needs. Nothing here is
# required to *run* the app — every provider is optional and it degrades to a
# setup notice rather than crashing — but a mode with no key cannot answer.
#
# Values marked PUBLIC are embedded in the browser bundle by Next.js. They are
# public by design (they identify the project, not a person) and must never be
# treated as secrets. Everything else is read on the server only.

# ── Supabase — accounts, cloud history, and the admin console ────────────────
# Without these the app is local-first: chats live in this browser's IndexedDB
# and there is no account, no cloud history, no admin console, no Dew ledger.
#
# Both values come from the Supabase dashboard → Project Settings → API: the
# project URL and the *anon* public key. The anon key is public by design — it
# identifies the project, not a person — and RLS (supabase/migrations/) is what
# protects every row. Never put the service_role key here or in any server
# route: nothing in this app needs it. See supabase/README.md for the one-time
# dashboard setup (Google, GitHub, Azure/Microsoft, Email/Password, redirect
# URLs).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Models — one key per mode, each optional ─────────────────────────────────
# Auto uses whichever of these is configured and falls back across them in
# order. Code deliberately does NOT cross between vendors: it stays inside the
# Gemini family or reports that no model was reachable.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Web search ───────────────────────────────────────────────────────────────
# Powers the composer's Auto/On search modes. Without it search is unavailable.
TAVILY_API_KEY=

# ── Administrator ────────────────────────────────────────────────────────────
# The one address allowed into the console and exempt from paying Dew. Access is
# a database grant, not a code path: promote the account with the service-role
# SQL in supabase/README.md so it holds a verified app_admin row, and RLS lets it
# read and write what nobody else can.
OPENMI_ADMIN_EMAIL=

# ── Web Push ─────────────────────────────────────────────────────────────────
# Generate a key pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# ── Deployment ───────────────────────────────────────────────────────────────
# The canonical origin. Required for correct share previews and the sitemap;
# without it Open Graph URLs resolve against localhost.
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Optional: shared rate limiting ───────────────────────────────────────────
# Leave both empty and the limiter runs per instance (resets on cold start,
# weaker under concurrency but zero setup). Set both and every instance shares
# one counter, so the limit actually means "per minute" across the deployment.
# Free tier at https://upstash.com is plenty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional: error monitoring ───────────────────────────────────────────────
# Leave empty and Sentry is inert: the SDK initialises disabled, makes no
# network calls, and the build succeeds without it. Set the DSN and errors
# from both the browser and the server start being reported — with conversation
# content stripped, which is what the beforeSend hooks in sentry.*.config.ts
# enforce. The three SENTRY_* values below are only needed to upload source
# maps at build time, which is what makes a stack trace readable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Accounts — required, and held by Supabase Auth ───────────────────────────
# Openmi has no guest mode. A visitor signs in or registers with Google, GitHub,
# Microsoft (Supabase's `azure` provider) or an email address and password; the
# sign-in screen is the whole interface until a session exists.
#
# Nothing has to be added to this file for any of the four doors. They are
# console switches plus OAuth credentials in the Supabase dashboard →
# Authentication → Sign In / Providers; NEXT_PUBLIC_SUPABASE_* above is all the
# client needs. Register both the deployed origin and localhost as redirect URLs
# there. See supabase/README.md for the click-by-click setup.
#
# Chats, preferences and connections all follow the account: every row is scoped
# to auth.uid() by row-level security. A confirmation mail is sent on email
# registration, but nothing is gated on it, so a person who cannot receive mail
# yet does not lose access.

# ── GitHub — the repository agent ────────────────────────────────────────────
# GitHub is AUTHORISATION, not a second login: the Firebase account stays the
# account, and the GitHub credential is attached to it, so the UID does not
# move. An account may hold several connections and picks one as the default.
#
# The simplest door is a **personal access token**: the panel accepts one pasted
# in, checks it with `GET /user` plus one repository listing, and seals it. That
# needs only GITHUB_TOKEN_KEY below — no OAuth App, no callback URL, no console
# change. A token that is alive but cannot read repositories is stored with a
# warning rather than refused, because adding the scope is the person's decision.
#
# The OAuth App below is the optional second door: a full-page round trip
# instead of a pasted token. Leave both empty and the token door still works.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Required for any GitHub connection. Encrypts every stored token at rest
# (AES-256-GCM) and signs the OAuth state. Any 32-byte hex string; rotating it
# forces every user to reconnect GitHub. Generate with:
#   openssl rand -hex 32
GITHUB_TOKEN_KEY=
#
# The callback URL is derived from the incoming request's host; set
# NEXT_PUBLIC_SITE_URL (below) to the public origin for a deployment behind a
# proxy that rewrites Host, and make sure it matches the OAuth App exactly.

# ── Agent turn signing ───────────────────────────────────────────────────────
# Signs the turn state that travels between agent steps (steps used, tokens
# spent, whether the turn was paid for). Keep it stable across instances and
# restarts, or a turn cannot continue on another instance. Any long random
# string; generate with: openssl rand -hex 32
# Falls back to GITHUB_TOKEN_KEY when unset, and to a per-process key when
# neither is set — which only works on a single long-lived instance.
AGENT_TURN_SECRET=

