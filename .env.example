# Server-side configuration. Copy to `.env.local` for `vercel dev` / the Vercel
# CLI, or to `.dev.vars` for `npm run dev:api` (the plain Node API server).
# Never commit the filled-in file.

# --- Firebase ---------------------------------------------------------------
# Project settings -> General -> Your apps (web app config)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_API_KEY="web-api-key"
# Optional: defaults to <project-id>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# FIREBASE_APP_ID="1:xxx:web:yyy"

# Service account (server-only). Project settings -> Service accounts ->
# Generate new private key. Literal \n escapes in the PEM are accepted.
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Encryption ------------------------------------------------------------
# base64 of 32 random bytes:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENC_KEY=""

# --- AI provider -----------------------------------------------------------
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# --- GitHub App (Phase 2) --------------------------------------------------
# App id / client id / slug are public and can live in env vars.
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_SLUG=""
# PKCS#8 PEM. Literal \n escapes are accepted.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
# Optional: separate HMAC key for install state (defaults to the webhook secret).
GITHUB_APP_STATE_SECRET=""

# --- Background runner (Vercel) --------------------------------------------
# `APP_ORIGIN` is inferred from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL on
# Vercel; set it explicitly for other hosts.
# APP_ORIGIN="https://your-app.vercel.app"
# Shared secret for the internal runner endpoint (generate a random 32+ chars).
INTERNAL_TASK_TOKEN=""
# Optional: dispatch tasks to a specific deployment instead of APP_ORIGIN.
# INTERNAL_DISPATCH_URL=""
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically.
CRON_SECRET=""
# Time a single invocation may spend on a task before handing off (seconds).
RUN_BUDGET_SECONDS="240"

# --- Behaviour -------------------------------------------------------------
OPENMI_MODEL="qwen/qwen3-coder"
DAILY_TASK_LIMIT="5"
MAX_CONCURRENT_TASKS="2"
DEFAULT_COMMIT_MODE="direct"
