rules_version = '2';

// OpenMi: all data access goes through the Vercel Function (admin SDK).
// Client access is denied entirely. The Firebase web config is public but
// useless without an ID token, and even with one the client cannot read or
// write any collection — the API is the only surface.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
